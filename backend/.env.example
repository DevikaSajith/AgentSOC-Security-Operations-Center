# AgentSOC backend configuration. Copy to backend/.env and edit.
# Every value is optional; empty values use the defaults shown in the comments.
# Never commit a real .env file.

# ------------------------------------------------------------------ database
# Default: SQLite file backend/agentsoc.db (no database server needed).
# PostgreSQL example (also: pip install psycopg2-binary):
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/agentsoc
DATABASE_URL=

# ------------------------------------------------------------------ server
# Used by `python -m app` (uvicorn CLI flags override them when running uvicorn directly).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated browser origins allowed to call the API directly (not needed when the
# Vite dev proxy is used). Default: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Folder with mitre_mapping.yaml etc. Default: <repo>/config
CONFIG_DIR=

# ------------------------------------------------------------------ LLM (Triage Agent)
# Local-first: no API key and no internet needed. Supported providers: ollama, none.
# With "none" (or if Ollama is down) the backend still works; Triage runs report
# status=failed / outcome=llm_unavailable|llm_not_configured and change nothing.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b                      # any model you have pulled: ollama pull <model>
OLLAMA_BASE_URL=http://localhost:11434  # bare origin only (no path/query/credentials)
LLM_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192                     # model context window (tokens)

# ------------------------------------------------------------------ tests
# Optional separate database for pytest (tables are DROPPED). Default: in-memory SQLite.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/agentsoc_test

# --- Remediation kill switch -------------------------------------------------
# While false (default) NO agent action is ever executed, even if the Remediation Agent proposed it,
# policy allows it and a human approved it (the approval is recorded; outcome "actions_disabled").
# Set to true to allow approved actions to run through the ToolExecutor against the SIMULATED cloud.
AGENT_ACTIONS_ENABLED=false
