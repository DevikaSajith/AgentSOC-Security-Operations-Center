# Copy to .env and fill in your values
# The Groq API key is the only required external credential.
# All other settings have safe defaults.

# ============================================================
# LLM Provider (Groq)
# ============================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ============================================================
# Server
# ============================================================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ============================================================
# Database (SQLite path — no PostgreSQL needed for agents)
# ============================================================
SQLITE_DB_PATH=./agentsoc.db

# ============================================================
# Agent Configuration
# ============================================================
# Directory containing config YAML files (relative to backend/)
CONFIG_DIR=../config

# ============================================================
# Security
# ============================================================
# Set to false to skip the approval gate for LOW/MEDIUM risk actions
REQUIRE_APPROVAL_FOR_MEDIUM=false
